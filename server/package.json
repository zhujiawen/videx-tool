{
  "name": "videx-server",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-platform video extraction web application",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "node --test",
    "test:live": "node --test test/live-platform.test.js",
    "check:runtime": "node -e \"require('./src/runtime').checkRuntimeDependencies().then(console.log).catch(e => { console.error(e.message); process.exit(1); })\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ipaddr.js": "2.2.0"
  }
}
